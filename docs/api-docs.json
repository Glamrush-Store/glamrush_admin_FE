{
  "info": {
    "_postman_id": "glamrush-admin-service-collection",
    "name": "GlamRush Admin API",
    "description": "API collection for GlamRush Admin Service — Laravel 12 e-commerce admin backend.\n\nSetup:\n1. Set the `base_url` variable (e.g. http://localhost:8000)\n2. Use the Login endpoint first — the token is auto-saved to `{{token}}`\n3. All authenticated endpoints use Bearer token from `{{token}}`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Returns API health status. No authentication required."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('Token saved to collection variable.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@glamrush.com\",\n    \"password\": \"password123\",\n    \"device_id\": \"postman-device-001\",\n    \"device_name\": \"Postman Client\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/account/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "account", "login"]
            },
            "description": "Authenticate a user and receive a Sanctum token. The token is automatically saved to the `{{token}}` collection variable."
          },
          "response": []
        },
        {
          "name": "Create Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john@glamrush.com\",\n    \"password\": \"Password1\",\n    \"password_confirmation\": \"Password1\",\n    \"device_id\": \"postman-device-001\",\n    \"device_name\": \"Postman Client\",\n    \"role\": \"super_admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/account/create",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "account", "create"]
            },
            "description": "Create a new admin user account. Requires `Create_User` permission."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/account/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "account", "logout"]
            },
            "description": "Revoke the current authentication token."
          },
          "response": []
        },
        {
          "name": "Who Am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/whoami",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "whoami"]
            },
            "description": "Get the currently authenticated user's details."
          },
          "response": []
        },
        {
          "name": "Request Password Reset",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@glamrush.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/password/reset/request",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "password", "reset", "request"]
            },
            "description": "Request a 6-digit password reset code sent to the user's email."
          },
          "response": []
        },
        {
          "name": "Verify Password Reset Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('Password reset token saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@glamrush.com\",\n    \"code\": \"777777\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/password/reset/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "password", "reset", "verify"]
            },
            "description": "Verify the 6-digit reset code. Returns a temporary token with `password:reset` ability."
          },
          "response": []
        },
        {
          "name": "Confirm Password Reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"password\": \"NewPassword1\",\n    \"password_confirmation\": \"NewPassword1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/password/reset/confirm",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "password", "reset", "confirm"]
            },
            "description": "Set a new password. Requires a token with `password:reset` ability (obtained from Verify step).\n\nPassword requirements: min 8 chars, at least 1 uppercase, 1 lowercase, 1 digit."
          },
          "response": []
        }
      ],
      "description": "Authentication, account management, and password reset endpoints."
    },
